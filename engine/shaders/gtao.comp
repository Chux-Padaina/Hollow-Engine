// Ground-truth ambient occlusion (Jimenez et al. 2016): for a few screen-
// space slices per pixel, find the maximum horizon angle on each side and
// integrate the cosine-weighted visible arc analytically.
#include "frame.glsl"

layout(local_size_x = 8, local_size_y = 8) in;
layout(binding = 0) uniform sampler2D t_depth;
layout(binding = 1) uniform sampler2D t_normals;
layout(r16f, binding = 0) uniform writeonly image2D i_ao;
uniform int u_slices;
uniform int u_steps;
uniform float u_radius;     // world units
uniform float u_proj_scale; // pixels per unit at depth 1

vec3 view_pos(ivec2 p) {
    vec2 uv = (vec2(p) + 0.5) * u_render_size.zw;
    float d = texelFetch(t_depth, p, 0).r;
    return view_from_depth(uv, max(d, 1e-7));
}

vec3 view_normal(ivec2 p) {
    vec2 e = texelFetch(t_normals, p, 0).xy * 2.0 - 1.0;
    return normalize(mat3(u_view) * decode_normal(e));
}

void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = ivec2(u_render_size.xy);
    if (any(greaterThanEqual(p, size))) {
        return;
    }
    float depth = texelFetch(t_depth, p, 0).r;
    if (depth <= 0.0) {
        imageStore(i_ao, p, vec4(1.0));
        return;
    }
    vec3 P = view_pos(p);
    vec3 N = view_normal(p);
    vec3 V = normalize(-P);
    float view_z = -P.z;
    float radius_px = u_radius * u_proj_scale / view_z;
    if (radius_px < 1.0) {
        imageStore(i_ao, p, vec4(1.0));
        return;
    }
    radius_px = min(radius_px, 256.0);
    float noise_dir = interleaved_gradient_noise(vec2(p), float(u_flags.w));
    float noise_step = fract(noise_dir * 7.31 + 0.27);
    float falloff_range = u_radius * 0.6;
    float visibility = 0.0;
    for (int s = 0; s < u_slices; ++s) {
        float phi = (float(s) + noise_dir) / float(u_slices) * PI;
        vec2 dir = vec2(cos(phi), sin(phi));
        vec3 dir3 = vec3(dir, 0.0);
        vec3 ortho = dir3 - dot(dir3, V) * V;
        vec3 axis = normalize(cross(dir3, V));
        vec3 proj_n = N - axis * dot(N, axis);
        float proj_len = length(proj_n);
        if (proj_len < 1e-4) {
            visibility += 1.0;
            continue;
        }
        float cos_n = clamp(dot(proj_n / proj_len, V), -1.0, 1.0);
        float n = sign(dot(ortho, proj_n)) * acos(cos_n);
        float h_cos[2] = float[](-1.0, -1.0);
        for (int side = 0; side < 2; ++side) {
            float sgn = side == 0 ? -1.0 : 1.0;
            for (int j = 0; j < u_steps; ++j) {
                float t = (float(j) + noise_step) / float(u_steps);
                t = t * t; // denser near the center
                vec2 offset = dir * sgn * max(t * radius_px, 1.0 + float(j));
                ivec2 sp = ivec2(vec2(p) + offset);
                if (any(lessThan(sp, ivec2(0))) || any(greaterThanEqual(sp, size))) {
                    break;
                }
                vec3 S = view_pos(sp);
                vec3 delta = S - P;
                float len = length(delta);
                float c = dot(delta / max(len, 1e-5), V);
                float falloff = saturate((u_radius - len) / falloff_range);
                h_cos[side] = max(h_cos[side], mix(-1.0, c, falloff));
            }
        }
        float h0 = n + max(-acos(h_cos[0]) - n, -0.5 * PI);
        float h1 = n + min(acos(h_cos[1]) - n, 0.5 * PI);
        float sin_n = sin(n);
        float arc0 = -cos(2.0 * h0 - n) + cos_n + 2.0 * h0 * sin_n;
        float arc1 = -cos(2.0 * h1 - n) + cos_n + 2.0 * h1 * sin_n;
        visibility += proj_len * 0.25 * (arc0 + arc1);
    }
    float ao = saturate(visibility / float(u_slices));
    imageStore(i_ao, p, vec4(ao));
}
