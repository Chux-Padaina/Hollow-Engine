// Clustered light culling: one thread per froxel cluster (screen tile x
// exponential depth slice). Lists the lights, decals and reflection probes
// touching each cluster.
#include "light_types.glsl"

layout(local_size_x = 64) in;

layout(std430, binding = SSBO_LIGHTS) readonly buffer LightBuffer { Light lights[]; };
layout(std430, binding = SSBO_DECALS) readonly buffer DecalBuffer { Decal decals[]; };
layout(std430, binding = SSBO_PROBES) readonly buffer ProbeBuffer { Probe probes[]; };
layout(std430, binding = SSBO_CLUSTER_GRID) writeonly buffer ClusterGrid { uvec4 clusters[]; };
layout(std430, binding = SSBO_CLUSTER_ITEMS) buffer ClusterItems { uint item_count; uint cluster_items[]; };

uniform uint u_capacity; // item slots

struct Box {
    vec3 lo;
    vec3 hi;
};

bool sphere_box(vec3 c, float r, Box b) {
    vec3 d = max(b.lo - c, vec3(0.0)) + max(c - b.hi, vec3(0.0));
    return dot(d, d) <= r * r;
}

bool cone_sphere(vec3 origin, vec3 dir, float range, float cos_angle, vec3 c, float r) {
    vec3 v = c - origin;
    float vlen2 = dot(v, v);
    float v1 = dot(v, dir);
    float sin_angle = sqrt(max(1.0 - cos_angle * cos_angle, 0.0));
    float closest = cos_angle * sqrt(max(vlen2 - v1 * v1, 0.0)) - v1 * sin_angle;
    return !(closest > r || v1 > r + range || v1 < -r);
}

vec3 view_ray(vec2 ndc) {
    vec4 v = u_inv_projection * vec4(ndc, 0.5, 1.0);
    v.xyz /= v.w;
    return v.xyz / -v.z; // z = -1
}

void main() {
    uint tiles_x = uint(u_cluster.x);
    uint tiles_y = uint(u_cluster.y);
    uint slices = uint(u_cluster.z);
    uint index = gl_GlobalInvocationID.x;
    if (index >= tiles_x * tiles_y * slices) {
        return;
    }
    uint tx = index % tiles_x;
    uint ty = (index / tiles_x) % tiles_y;
    uint slice = index / (tiles_x * tiles_y);

    // View-space AABB of the cluster.
    vec2 px_min = vec2(tx, ty) * u_cluster.w;
    vec2 px_max = min(px_min + u_cluster.w, u_render_size.xy);
    vec2 ndc_min = px_min * u_render_size.zw * 2.0 - 1.0;
    vec2 ndc_max = px_max * u_render_size.zw * 2.0 - 1.0;
    float near = u_cluster_z.z;
    float far = u_cluster_z.w;
    float z0 = near * pow(far / near, float(slice) / float(slices));
    float z1 = near * pow(far / near, float(slice + 1u) / float(slices));
    if (slice == slices - 1u) {
        z1 = 1e6; // the last slice reaches to infinity
    }
    Box box;
    box.lo = vec3(1e9);
    box.hi = vec3(-1e9);
    vec3 rays[4] = vec3[](view_ray(ndc_min), view_ray(vec2(ndc_max.x, ndc_min.y)), view_ray(vec2(ndc_min.x, ndc_max.y)), view_ray(ndc_max));
    for (int i = 0; i < 4; ++i) {
        vec3 a = rays[i] * z0;
        vec3 b = rays[i] * z1;
        box.lo = min(box.lo, min(a, b));
        box.hi = max(box.hi, max(a, b));
    }
    vec3 box_center = (box.lo + box.hi) * 0.5;
    float box_radius = length(box.hi - box.lo) * 0.5;

    int light_total = u_flags.z;
    int first_local = int(u_counts.w);
    int decal_total = int(u_counts.z);
    int probe_total = int(u_counts.x);

    // Pass 0 counts, pass 1 writes.
    uint counts[3] = uint[](0u, 0u, 0u);
    uint base = 0u;
    for (int pass = 0; pass < 2; ++pass) {
        uint written = 0u;
        for (int i = first_local; i < light_total; ++i) {
            Light light = lights[i];
            vec3 c = (u_view * vec4(light.position_range.xyz, 1.0)).xyz;
            float r = light.position_range.w;
            if (!sphere_box(c, r, box)) {
                continue;
            }
            if (int(light.direction_type.w) == LIGHT_SPOT) {
                vec3 dir = normalize((u_view * vec4(light.direction_type.xyz, 0.0)).xyz);
                float cos_outer = -light.spot_shadow.y / max(light.spot_shadow.x, 1e-4);
                if (!cone_sphere(c, dir, r, cos_outer, box_center, box_radius)) {
                    continue;
                }
            }
            if (pass == 0) {
                counts[0]++;
            } else if (written < counts[0]) {
                cluster_items[base + written++] = uint(i);
            }
        }
        uint decal_written = 0u;
        for (int i = 0; i < decal_total; ++i) {
            vec4 b = decals[i].bounds;
            vec3 c = (u_view * vec4(b.xyz, 1.0)).xyz;
            if (!sphere_box(c, b.w, box)) {
                continue;
            }
            if (pass == 0) {
                counts[1]++;
            } else if (decal_written < counts[1]) {
                cluster_items[base + counts[0] + decal_written++] = uint(i);
            }
        }
        uint probe_written = 0u;
        for (int i = 0; i < probe_total; ++i) {
            Probe probe = probes[i];
            vec3 wc = (probe.box_min.xyz + probe.box_max.xyz) * 0.5;
            float r = length(probe.box_max.xyz - probe.box_min.xyz) * 0.5;
            vec3 c = (u_view * vec4(wc, 1.0)).xyz;
            if (!sphere_box(c, r, box)) {
                continue;
            }
            if (pass == 0) {
                counts[2]++;
            } else if (probe_written < counts[2]) {
                cluster_items[base + counts[0] + counts[1] + probe_written++] = uint(i);
            }
        }
        if (pass == 0) {
            counts[0] = min(counts[0], 128u);
            counts[1] = min(counts[1], 32u);
            counts[2] = min(counts[2], 16u);
            uint total = counts[0] + counts[1] + counts[2];
            base = atomicAdd(item_count, total);
            if (base + total > u_capacity) {
                counts = uint[](0u, 0u, 0u);
                base = 0u;
                clusters[index] = uvec4(0u);
                return;
            }
        }
    }
    clusters[index] = uvec4(base, counts[0], counts[1], counts[2]);
}
