// Projects a captured cubemap onto L1 spherical harmonics, cosine-
// convolved (diffuse radiance for albedo 1: a + b.n per channel), and
// writes one irradiance-volume probe into the SH atlas (see ibl.glsl).
#include "common.glsl"

layout(local_size_x = 64) in;

layout(binding = 0) uniform samplerCube t_capture;
layout(rgba16f, binding = 0) uniform writeonly image3D i_sh0;
layout(rgba16f, binding = 1) uniform writeonly image3D i_sh1;
layout(rgba16f, binding = 2) uniform writeonly image3D i_sh2;

uniform int u_size;      // capture face size
uniform float u_scale;   // 1 / capture exposure: back to physical radiance
uniform ivec3 u_texel;   // destination texel

shared vec3 s_l0[64];
shared vec3 s_lx[64];
shared vec3 s_ly[64];
shared vec3 s_lz[64];
shared float s_w[64];

vec3 face_direction(int face, vec2 uv) {
    switch (face) {
    case 0: return vec3(1.0, -uv.y, -uv.x);
    case 1: return vec3(-1.0, -uv.y, uv.x);
    case 2: return vec3(uv.x, 1.0, uv.y);
    case 3: return vec3(uv.x, -1.0, -uv.y);
    case 4: return vec3(uv.x, -uv.y, 1.0);
    default: return vec3(-uv.x, -uv.y, -1.0);
    }
}

void main() {
    uint tid = gl_LocalInvocationIndex;
    vec3 l0 = vec3(0.0);
    vec3 lx = vec3(0.0);
    vec3 ly = vec3(0.0);
    vec3 lz = vec3(0.0);
    float wsum = 0.0;
    int per_face = u_size * u_size;
    for (int i = int(tid); i < per_face * 6; i += 64) {
        int face = i / per_face;
        int texel = i % per_face;
        vec2 uv = (vec2(texel % u_size, texel / u_size) + 0.5) / float(u_size) * 2.0 - 1.0;
        float w = 4.0 / pow(1.0 + dot(uv, uv), 1.5);
        vec3 d = normalize(face_direction(face, uv));
        vec3 L = textureLod(t_capture, d, 0.0).rgb * u_scale;
        l0 += L * w;
        lx += L * (w * d.x);
        ly += L * (w * d.y);
        lz += L * (w * d.z);
        wsum += w;
    }
    s_l0[tid] = l0;
    s_lx[tid] = lx;
    s_ly[tid] = ly;
    s_lz[tid] = lz;
    s_w[tid] = wsum;
    barrier();
    for (uint stride = 32u; stride > 0u; stride >>= 1u) {
        if (tid < stride) {
            s_l0[tid] += s_l0[tid + stride];
            s_lx[tid] += s_lx[tid + stride];
            s_ly[tid] += s_ly[tid + stride];
            s_lz[tid] += s_lz[tid + stride];
            s_w[tid] += s_w[tid + stride];
        }
        barrier();
    }
    if (tid != 0u) {
        return;
    }
    float norm = 4.0 * PI / max(s_w[0], 1e-6);
    // Y00 = 0.282095, Y1m = 0.488603 * axis; cosine lobe A0 = pi, A1 = 2pi/3,
    // and /pi for diffuse radiance.
    vec3 a = s_l0[0] * norm * 0.282095 * 0.282095;
    float k = 0.488603 * 0.488603 * (2.0 / 3.0) * norm;
    vec3 bx = s_lx[0] * k;
    vec3 by = s_ly[0] * k;
    vec3 bz = s_lz[0] * k;
    vec3 br = vec3(bx.r, by.r, bz.r);
    vec3 bg = vec3(bx.g, by.g, bz.g);
    vec3 bb = vec3(bx.b, by.b, bz.b);
    imageStore(i_sh0, u_texel, vec4(a, br.x));
    imageStore(i_sh1, u_texel, vec4(br.y, br.z, bg.x, bg.y));
    imageStore(i_sh2, u_texel, vec4(bg.z, bb));
}
