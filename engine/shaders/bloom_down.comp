// Bloom downsample (Jimenez 2014, "Next Generation Post Processing in
// Call of Duty"): 13-tap filter; the first level uses a Karis average to
// stop fireflies.
#include "common.glsl"

layout(local_size_x = 8, local_size_y = 8) in;
layout(binding = 0) uniform sampler2D t_source;
layout(rgba16f, binding = 0) uniform writeonly image2D i_dest;
uniform int u_first;
uniform float u_source_lod;

vec3 tap(vec2 uv) {
    return textureLod(t_source, uv, u_source_lod).rgb;
}

float karis(vec3 c) {
    return 1.0 / (1.0 + luminance(c));
}

void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(i_dest);
    if (any(greaterThanEqual(p, size))) {
        return;
    }
    vec2 texel = 1.0 / vec2(size);
    vec2 uv = (vec2(p) + 0.5) * texel;
    vec2 t = texel * 0.5; // source texel
    vec3 a = tap(uv + t * vec2(-2, -2));
    vec3 b = tap(uv + t * vec2(0, -2));
    vec3 c = tap(uv + t * vec2(2, -2));
    vec3 d = tap(uv + t * vec2(-2, 0));
    vec3 e = tap(uv);
    vec3 f = tap(uv + t * vec2(2, 0));
    vec3 g = tap(uv + t * vec2(-2, 2));
    vec3 h = tap(uv + t * vec2(0, 2));
    vec3 i = tap(uv + t * vec2(2, 2));
    vec3 j = tap(uv + t * vec2(-1, -1));
    vec3 k = tap(uv + t * vec2(1, -1));
    vec3 l = tap(uv + t * vec2(-1, 1));
    vec3 m = tap(uv + t * vec2(1, 1));
    vec3 result;
    if (u_first != 0) {
        vec3 g0 = (a + b + d + e) * 0.25;
        vec3 g1 = (b + c + e + f) * 0.25;
        vec3 g2 = (d + e + g + h) * 0.25;
        vec3 g3 = (e + f + h + i) * 0.25;
        vec3 g4 = (j + k + l + m) * 0.25;
        float w0 = karis(g0) * 0.125;
        float w1 = karis(g1) * 0.125;
        float w2 = karis(g2) * 0.125;
        float w3 = karis(g3) * 0.125;
        float w4 = karis(g4) * 0.5;
        result = (g0 * w0 + g1 * w1 + g2 * w2 + g3 * w3 + g4 * w4) / (w0 + w1 + w2 + w3 + w4);
    } else {
        result = e * 0.125 + (a + c + g + i) * 0.03125 + (b + d + f + h) * 0.0625 + (j + k + l + m) * 0.125;
    }
    imageStore(i_dest, p, vec4(min(result, vec3(65000.0)), 1.0));
}
