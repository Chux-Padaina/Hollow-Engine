// GPU particle simulation: one thread per particle slot. The emitter's
// new particles for this frame occupy a ring-buffer range
// [u_emit_start, u_emit_start + u_emit_count) that is (re)spawned here.
#include "frame.glsl"
#include "common.glsl"
#include "particle_common.glsl"

layout(local_size_x = 64) in;

uniform uint u_capacity;
uniform uint u_emit_start;
uniform uint u_emit_count;
uniform uint u_seed;
uniform mat4 u_spawn;        // emitter transform (identity for local-space systems)
uniform int u_shape;         // 0 point, 1 sphere, 2 box, 3 cone
uniform vec3 u_shape_size;
uniform float u_cone_angle;
uniform vec2 u_speed;        // speed, variance
uniform vec2 u_lifetime;     // lifetime, variance
uniform float u_gravity;
uniform float u_drag;
uniform float u_noise;

float rand(inout uint state) {
    state = hash_u32(state);
    return float(state) / 4294967296.0;
}

vec3 turbulence(vec3 p, float t) {
    return vec3(sin(p.y * 1.7 + t * 1.1) + sin(p.z * 2.3 - t * 0.7),
                sin(p.z * 1.9 + t * 0.9) * 0.5,
                sin(p.x * 2.1 - t * 1.3) + sin(p.y * 1.3 + t * 0.6));
}

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= u_capacity) {
        return;
    }
    float dt = u_time.x;
    Particle p = particles[i];
    uint relative = (i + u_capacity - u_emit_start) % u_capacity;
    if (relative < u_emit_count) {
        uint state = i * 9781u + u_seed * 6271u + 1u;
        vec3 position = vec3(0.0);
        vec3 direction = vec3(0.0, 1.0, 0.0);
        if (u_shape == 1) {
            vec3 d = normalize(vec3(rand(state), rand(state), rand(state)) * 2.0 - 1.0 + 1e-4);
            position = d * u_shape_size.x * pow(rand(state), 1.0 / 3.0);
            direction = d;
        } else if (u_shape == 2) {
            position = (vec3(rand(state), rand(state), rand(state)) * 2.0 - 1.0) * u_shape_size;
        } else if (u_shape == 3) {
            float r = u_shape_size.x * sqrt(rand(state));
            float phi = rand(state) * TWO_PI;
            position = vec3(cos(phi) * r, 0.0, sin(phi) * r);
            float cos_theta = mix(1.0, cos(u_cone_angle), rand(state));
            float sin_theta = sqrt(max(1.0 - cos_theta * cos_theta, 0.0));
            float psi = rand(state) * TWO_PI;
            direction = vec3(cos(psi) * sin_theta, cos_theta, sin(psi) * sin_theta);
        }
        float speed = u_speed.x * (1.0 + u_speed.y * (rand(state) * 2.0 - 1.0));
        float life = max(u_lifetime.x * (1.0 + u_lifetime.y * (rand(state) * 2.0 - 1.0)), 0.05);
        p.position_age = vec4((u_spawn * vec4(position, 1.0)).xyz, 0.0);
        p.velocity_life = vec4(normalize(mat3(u_spawn) * direction) * speed, life);
        p.extra = vec4(rand(state), rand(state), 0.0, 0.0);
        // Spread the new particles over the frame so bursts don't band.
        dt *= float(relative + 1u) / float(u_emit_count);
    } else if (p.position_age.w >= p.velocity_life.w) {
        return; // dead
    }
    vec3 v = p.velocity_life.xyz;
    v.y -= 9.81 * u_gravity * dt;
    v += turbulence(p.position_age.xyz, u_time.y) * u_noise * dt;
    v *= exp(-u_drag * dt);
    p.velocity_life.xyz = v;
    p.position_age.xyz += v * dt;
    p.position_age.w += dt;
    particles[i] = p;
}
