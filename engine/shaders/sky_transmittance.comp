// Transmittance from a point to the top of the atmosphere (256 x 64).
#include "atmosphere.glsl"

layout(local_size_x = 8, local_size_y = 8) in;
layout(rgba16f, binding = 0) uniform writeonly image2D i_lut;

void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(i_lut);
    if (any(greaterThanEqual(p, size))) {
        return;
    }
    Atmosphere a = get_atmosphere();
    float r;
    float mu;
    transmittance_params(a, (vec2(p) + 0.5) / vec2(size), r, mu);
    vec3 ro = vec3(0.0, r, 0.0);
    vec3 rd = vec3(sqrt(1.0 - mu * mu), mu, 0.0);
    float t_max = ray_sphere(ro, rd, a.top);
    vec3 optical = vec3(0.0);
    const int STEPS = 40;
    float dt = t_max / float(STEPS);
    for (int i = 0; i < STEPS; ++i) {
        vec3 pos = ro + rd * (float(i) + 0.5) * dt;
        optical += sample_medium(a, pos).extinction * dt;
    }
    imageStore(i_lut, p, vec4(exp(-optical), 1.0));
}
