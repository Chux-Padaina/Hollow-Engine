// Fills every mip texel of one probe-array layer with a constant color.
layout(local_size_x = 8, local_size_y = 8) in;
layout(rgba16f, binding = 0) uniform writeonly imageCubeArray i_target;
uniform int u_layer;
uniform vec3 u_color;

void main() {
    ivec3 p = ivec3(gl_GlobalInvocationID.xyz);
    int size = imageSize(i_target).x;
    if (p.x >= size || p.y >= size) {
        return;
    }
    imageStore(i_target, ivec3(p.xy, u_layer * 6 + p.z), vec4(u_color, 1.0));
}
