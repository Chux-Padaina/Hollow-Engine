// Multiple-scattering contribution LUT (32 x 32): for each height and sun
// angle, the isotropic multiple-scattering radiance factor (Hillaire 2020,
// section 5.5).
#include "atmosphere.glsl"

layout(local_size_x = 8, local_size_y = 8) in;
layout(rgba16f, binding = 0) uniform writeonly image2D i_lut;

void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(i_lut);
    if (any(greaterThanEqual(p, size))) {
        return;
    }
    Atmosphere a = get_atmosphere();
    vec2 uv = (vec2(p) + 0.5) / vec2(size);
    float sun_cos = uv.x * 2.0 - 1.0;
    float height = a.bottom + saturate(uv.y + 1e-3) * (a.top - a.bottom - 0.01);
    vec3 ro = vec3(0.0, height, 0.0);
    vec3 sun = vec3(sqrt(saturate(1.0 - sun_cos * sun_cos)), sun_cos, 0.0);

    vec3 l2 = vec3(0.0);
    vec3 fms = vec3(0.0);
    const int DIRS = 8;
    for (int iy = 0; iy < DIRS; ++iy) {
        for (int ix = 0; ix < DIRS; ++ix) {
            float u = (float(ix) + 0.5) / float(DIRS);
            float v = (float(iy) + 0.5) / float(DIRS);
            float phi = TWO_PI * u;
            float cos_theta = 1.0 - 2.0 * v;
            float sin_theta = sqrt(max(1.0 - cos_theta * cos_theta, 0.0));
            vec3 rd = vec3(cos(phi) * sin_theta, cos_theta, sin(phi) * sin_theta);
            float t_ground = ray_sphere(ro, rd, a.bottom);
            float t_top = ray_sphere(ro, rd, a.top);
            float t_max = t_ground > 0.0 ? t_ground : t_top;
            const int STEPS = 20;
            float dt = t_max / float(STEPS);
            vec3 throughput = vec3(1.0);
            vec3 lum = vec3(0.0);
            vec3 lum_f = vec3(0.0);
            for (int s = 0; s < STEPS; ++s) {
                vec3 pos = ro + rd * (float(s) + 0.5) * dt;
                Medium m = sample_medium(a, pos);
                vec3 step_t = exp(-m.extinction * dt);
                float r = length(pos);
                vec3 up = pos / r;
                vec3 sun_t = transmittance_to_top(a, r, dot(sun, up));
                float planet = ray_sphere(pos, sun, a.bottom) > 0.0 ? 0.0 : 1.0;
                vec3 s_light = planet * sun_t * m.scattering / (4.0 * PI);
                vec3 integ = (s_light - s_light * step_t) / max(m.extinction, vec3(1e-6));
                lum += throughput * integ;
                vec3 f_integ = (m.scattering - m.scattering * step_t) / max(m.extinction, vec3(1e-6));
                lum_f += throughput * f_integ;
                throughput *= step_t;
            }
            if (t_ground > 0.0) {
                vec3 pos = ro + rd * t_ground;
                vec3 up = normalize(pos);
                vec3 sun_t = transmittance_to_top(a, length(pos), dot(sun, up));
                lum += throughput * sun_t * saturate(dot(up, sun)) * a.ground_albedo / PI;
            }
            l2 += lum;
            fms += lum_f;
        }
    }
    float inv = 1.0 / float(DIRS * DIRS);
    l2 *= inv;
    fms *= inv;
    vec3 psi = l2 / max(1.0 - fms, vec3(1e-3));
    imageStore(i_lut, p, vec4(psi, 1.0));
}
